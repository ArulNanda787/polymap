# ==========================================
# POLYMAP — Python / ML / Research .gitignore
# ==========================================

# --- Data: raw, processed, downloaded, generated ---
# Anchored to specific folders on purpose: bare names like `data/`, `models/`
# and `runs/` also matched source code (backend/src/polymap/data/,
# backend/src/polymap/models/) and frontend/data/ + frontend/app/runs/.
/backend/data/
/backend/datasets/
/backend/artifacts/
/backend/outputs/
/backend/results/
/backend/checkpoints/
/backend/models/
/backend/runs/
/data/
/datasets/
/models/
/runs/
checkpoints/
mlruns/
wandb/
lightning_logs/
tensorboard/

# --- Large data and model files ---
*.parquet
*.parquet.gzip
*.feather
*.arrow
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.pb
*.tflite
*.model
*.bin

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/
.python-version.local

# --- Python bytecode and caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
pytestdebug.log

# --- Python packaging / build outputs ---
build/
dist/
site/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# --- Secrets and local environment configuration ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
service-account*.json

# --- Logs and temporary files ---
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.old
*.dump
*.core

# --- Jupyter notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile/
.prof
*.prof
*.ipynb~
.DS_Store

# --- macOS ---
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.VolumeIcon.icns

# --- Windows ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Linux ---
*~
.directory
.Trash-*/

# --- IDEs and editors ---
.idea/
.vscode/
*.code-workspace
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# --- Node / frontend tooling, if present ---
node_modules/
.npm/
.pnpm-store/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.turbo/
coverage/

# --- Local databases and database sidecars ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-wal
*.sqlite-shm

# --- Cloud / infrastructure local state ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Experiment / profiler outputs ---
.prof/
*.prof
*.trace
*.gcda
*.gcno

# --- Keep useful project templates and placeholders ---
# Explicit exceptions above preserve .env.example and .env.template

# Local temporary files
/untitled folder/
/untitled folder.zip
/backup_before_baselines/

# Python environments anywhere in the project
**/.venv/
**/venv/
**/__pycache__/

# Research data: see the anchored /backend/data/ rules at the top.
# (A blanket **/data/ rule here used to hide source code and frontend/data/.)

# Local backup and temporary files
/backup_before_baselines/
/untitled folder/
/untitled folder.zip

# Old frontend kept locally after the 3 Nov 2026 swap
/frontend_old/
